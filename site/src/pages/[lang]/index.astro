---
/**
 * Home page: one column of listing cards, soonest first
 * (PROJECT.md 2; docs/briefs/phase1-home-page.md). One page per language.
 * Weekly picks (decision 0008) come in the next slice.
 *
 * The list also holds the flexible opportunities (decision 0018), hidden
 * until the Kind filter asks for them (owner, 2026-11-08); without
 * JavaScript the list shows dated shifts only, as before.
 */
import ResultsHeading from "../../components/ResultsHeading.astro";
import SharePanel from "../../components/SharePanel.astro";
import SearchBox from "../../components/SearchBox.astro";
import Base from "../../layouts/Base.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import ListingCard from "../../components/ui/ListingCard.astro";
import OriginalText from "../../components/OriginalText.astro";
import MapView from "../../components/MapView.astro";
import { mapAttrs } from "../../lib/map-build.ts";
import { languagePaths, paths, siteData, translator } from "../../lib/site.ts";
import { cardSearchText, businessLabel, joinLabel, placeSpoken, placeText, requirementFacts, spotsLabel, timeText, typeLabel, whenText } from "../../lib/words.ts";
import { listingText, shownListing } from "../../i18n/listing-text.ts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.params as { lang: string };
const { i18n, listings, opportunities, builtAt, settings } = siteData();
const tr = translator(lang);
const t = tr.t;
// Any flexible card shown in this language as a machine translation (decision 0036).
const anyTranslatedOut = opportunities.some((o) => shownListing(o, lang).translated);
const alternates = Object.fromEntries(i18n.languages.map((code) => [code, paths.home(code)]));

/** The same fact lines as on the Flexible and Teams pages. */
function flexibleFacts(o: (typeof opportunities)[number]) {
  const out: Array<{ template: string; name: string; value: string; lang?: string }> = [];
  if (o.team_required && o.team_size) out.push({ template: t("teams.size"), name: "size", value: o.team_size, lang: o.listing_language });
  if (o.team_required && o.team_task) out.push({ template: t("teams.task"), name: "task", value: listingText(o, "team_task", lang)!.text, lang: listingText(o, "team_task", lang)!.lang });
  if (o.min_age !== null) out.push({ template: t("listing.min_age"), name: "age", value: tr.formatNumber(o.min_age) });
  out.push(...requirementFacts(tr, o));
  if (o.commitment) out.push({ template: t("flexible.commitment"), name: "commitment", value: listingText(o, "commitment", lang)!.text, lang: listingText(o, "commitment", lang)!.lang });
  return out;
}
---

<Base lang={lang} alternates={alternates} path={paths.home(lang)}>
  <div class="page results">
    <ResultsHeading lang={lang} text={t("filters.heading")} filters />
    {/* Under the Filters button, side by side (owner, 2026-11-10). */}
    <ul class="home-pages">
      <li><a href={paths.flexible(lang)}>{t("home.flexible_link")}</a></li>
      <li><a href={paths.teams(lang)}>{t("home.teams_link")}</a></li>
    </ul>
  </div>
  <FilterPanel lang={lang} />
  <div class="page results">
    <div class="results__bar">
    <p
      id="results-count"
      class="results__count"
      role="status"
      data-count-one={t("results.count.one")}
      data-count-other={t("results.count.other")}
      data-count-flexible-one={t("flexible.count.one")}
      data-count-flexible-other={t("flexible.count.other")}
      data-count-teams-one={t("teams.count.one")}
      data-count-teams-other={t("teams.count.other")}
    >
      {tr.plural("results.count", listings.length)}
    </p>
    <SearchBox lang={lang} />
    </div>
    <MapView lang={lang} mode="day" kind="dated" />
    <div
      id="results-none"
      class="results__none"
      hidden={listings.length > 0}
      data-empty-dated={t("results.empty")}
      data-match-dated={t("results.none")}
      data-hint-dated={t("results.none_hint")}
      data-empty-flexible={t("flexible.none")}
      data-match-flexible={t("flexible.none_match")}
      data-hint-flexible={t("flexible.none_match_hint")}
      data-empty-teams={t("teams.none")}
      data-match-teams={t("teams.none_match")}
      data-hint-teams={t("flexible.none_match_hint")}
      data-search-none={t("search.none")}
      data-search-hint={t("search.none_hint")}
    >
      <p data-none-main>{listings.length > 0 ? t("results.none") : t("results.empty")}</p>
      <p class="muted" data-none-hint hidden={listings.length === 0}>{t("results.none_hint")}</p>
    </div>
    <p id="external-note" class="muted" hidden>{t("listing.external_note")}</p>
    {/* Cards that link straight to the organization have no page of ours to carry the full note (decision 0036; licence gate). */}
    {anyTranslatedOut && <p id="translated-note" class="muted" hidden>{t("listing.translated_note_list")}</p>}

    <ul id="listing-list" class="stack listing-list">
      {
        listings.map((e) => (
          <li
            data-id={e.id}
            data-date={e.localDate}
            data-weekday={e.weekday}
            data-time={e.timeOfDay}
            data-area={e.area}
            data-cause={e.cause ?? ""}
            data-type={e.type}
            data-join={e.join_method}
            data-training={e.training_required === null ? "" : String(e.training_required)}
            data-spanish={String(e.spanish_spoken)}
            data-host={e.host_type ?? ""}
            data-faith={e.faith_tradition ?? ""}
            data-activity={(e.activity ?? []).join(" ")}
            data-team={String(e.team_required === true)}
            data-kind="dated"
            data-search={cardSearchText(tr, e, settings)}
            data-over-at={e.overAt}
            {...mapAttrs(tr, e, settings, { href: paths.listing(lang, e.id), when: timeText(tr, e) })}
          >
            <ListingCard
              id={e.id}
              href={paths.listing(lang, e.id)}
              title={shownListing(e, lang).title.text}
              titleLang={shownListing(e, lang).title.lang}
              orgLang={e.listing_language}
              translatedLabel={shownListing(e, lang).translated ? t("listing.translated_automatically") : undefined}
              org={e.org_name}
              hostedBy={t("listing.hosted_by")}
              when={whenText(tr, e)}
              datetime={e.start}
              place={placeText(tr, e, settings)}
              placeSpoken={placeSpoken(tr, e, settings)}
              cause={e.cause}
              joinMethod={e.join_method}
              joinLabel={joinLabel(tr, e)}
              type={typeLabel(tr, e) ? e.type : undefined}
              typeLabel={typeLabel(tr, e)}
              businessLabel={businessLabel(tr, e)}
              teamLabel={e.team_required ? t("teams.tag") : undefined}
              spots={spotsLabel(tr, e, builtAt)}
              saveLabel={t("listing.save")}
              shareLabel={t("listing.share")}
              shareUrl={paths.listing(lang, e.id)}
              headingLevel={2}
            />
            {e.approximate && <p class="map-approx-line" data-map-approx-line hidden>{t("map.approximate")}</p>}
          </li>
        ))
      }
      {
        opportunities.map((o) => (
          <li
            data-id={o.id}
            data-kind="flexible"
            data-search={cardSearchText(tr, o, settings)}
            data-area={o.area}
            data-cause={o.cause ?? ""}
            data-type={o.type}
            data-join={o.join_method}
            data-training={o.training_required === null ? "" : String(o.training_required)}
            data-spanish={String(o.spanish_spoken)}
            data-host={o.host_type ?? ""}
            data-faith={o.faith_tradition ?? ""}
            data-activity={(o.activity ?? []).join(" ")}
            data-team={String(o.team_required === true)}
            hidden
          >
            <ListingCard
              id={o.id}
              href={o.signup_url}
              shareLabel={t("listing.share")}
              shareUrl={o.signup_url}
              external
              describedBy="external-note"
              title={shownListing(o, lang).title.text}
              titleLang={shownListing(o, lang).title.lang}
              orgLang={o.listing_language}
              translatedLabel={shownListing(o, lang).translated ? t("listing.translated_automatically") : undefined}
              org={o.org_name}
              hostedBy={t("listing.hosted_by")}
              place={placeText(tr, o, settings)}
              placeSpoken={placeSpoken(tr, o, settings)}
              flexibleLabel={t("flexible.tag")}
              teamLabel={o.team_required ? t("teams.tag") : undefined}
              facts={flexibleFacts(o)}
              cause={o.cause}
              joinMethod={o.join_method}
              joinLabel={t(`filters.join.${o.join_method}`)}
              headingLevel={2}
            />
            <OriginalText lang={lang} item={o} />
          </li>
        ))
      }
    </ul>
    <p
      id="action-status"
      class="action-status"
      role="status"
      data-copied={t("listing.share_copied")}
      data-failed={t("listing.share_failed")}
    >
    </p>
  </div>
  <SharePanel lang={lang} />
</Base>

<script>
  import "../../scripts/actions.ts";
  import "../../scripts/share-panel.ts";
  import "../../scripts/filters.ts";
</script>


<style>
  /* Two links side by side, right-aligned under the Filters button; they wrap on a narrow screen.
     Each is a 48 px tall target with the site's focus ring. */
  .home-pages {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--space-4);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }
  .home-pages a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
