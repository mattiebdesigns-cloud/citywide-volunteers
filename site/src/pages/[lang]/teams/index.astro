---
/**
 * Volunteer Teams (decision 0020; PROJECT.md 2, 4, 5): every activity that
 * needs a team, not one person, whether it has a date (calendar listings with
 * team_required) or is arranged with the organization (flexible opportunities
 * with team_required). Built like the Flexible page: same cards, same
 * filters (part of the city, cause, how to join), its own filter memory.
 * Dated ones come first, soonest first, and link to our listing page; the
 * others link out to the organization's own page.
 */
import ResultsHeading from "../../../components/ResultsHeading.astro";
import SharePanel from "../../../components/SharePanel.astro";
import SearchBox from "../../../components/SearchBox.astro";
import Base from "../../../layouts/Base.astro";
import FlexibleFilterPanel from "../../../components/FlexibleFilterPanel.astro";
import ListingCard from "../../../components/ui/ListingCard.astro";
import OriginalText from "../../../components/OriginalText.astro";
import MapCardLines from "../../../components/MapCardLines.astro";
import PageTabs from "../../../components/PageTabs.astro";
import MapSwitch from "../../../components/MapSwitch.astro";
import CardLogLink from "../../../components/CardLogLink.astro";
import MapView from "../../../components/MapView.astro";
import { mapAttrs } from "../../../lib/map-build.ts";
import { TEAMS_FILTERS_KEY } from "../../../scripts/device.ts";
import { languagePaths, paths, siteData, translator } from "../../../lib/site.ts";
import { cardSearchText, joinLabel, placeSpoken, placeText, requirementFacts, whenText } from "../../../lib/words.ts";
import { listingText, shownListing } from "../../../i18n/listing-text.ts";
import type { Opportunity, PreparedListing } from "../../../lib/types.ts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.params as { lang: string };
const { i18n, listings, opportunities, settings } = siteData();
const tr = translator(lang);
const t = tr.t;
const alternates = Object.fromEntries(i18n.languages.map((code) => [code, paths.teams(code)]));

const dated = listings.filter((e) => e.team_required);
const arranged = opportunities.filter((o) => o.team_required);
// Any arranged card shown here as a machine translation, linking straight to the organization (decision 0036).
const anyTranslatedOut = arranged.some((o) => shownListing(o, lang).translated);
const items = [...dated, ...arranged];
const any = items.length > 0;

type Fact = { template: string; name: string; value: string; lang?: string };
function teamFacts(o: PreparedListing | Opportunity): Fact[] {
  const out: Fact[] = [];
  if (o.team_size) out.push({ template: t("teams.size"), name: "size", value: o.team_size, lang: o.listing_language });
  if (o.team_task) out.push({ template: t("teams.task"), name: "task", value: listingText(o, "team_task", lang)!.text, lang: listingText(o, "team_task", lang)!.lang });
  if (o.min_age !== null) out.push({ template: t("listing.min_age"), name: "age", value: tr.formatNumber(o.min_age) });
  out.push(...requirementFacts(tr, o));
  if ("commitment" in o && o.commitment) {
    out.push({ template: t("flexible.commitment"), name: "commitment", value: listingText(o, "commitment", lang)!.text, lang: listingText(o, "commitment", lang)!.lang });
  }
  return out;
}
---

<Base lang={lang} title={t("teams.title")} alternates={alternates} path={paths.teams(lang)} mapCredits>
  <div class="page results">
    <p class="teams__back"><a class="tap-link" href={paths.home(lang)}>{t("listing.back")}</a></p>
    <ResultsHeading lang={lang} text={t("teams.title")} filters={any} />
    <PageTabs lang={lang} current="teams" />
    <p>{t("teams.intro")}</p>
  </div>
  {
    any && (
      <FlexibleFilterPanel lang={lang} items={items} applyLabel={t("teams.apply")} storageKey={TEAMS_FILTERS_KEY} />
    )
  }
  <div class="page results">
    {
      any ? (
        <>
          <p id="external-note" class="muted">{t("listing.external_note")}</p>
          {/* Shown once when a card here links straight to the organization in machine-translated words (decision 0036; licence gate). */}
          {anyTranslatedOut && <p id="translated-note" class="muted">{t("listing.translated_note_list")}</p>}
          <div class="results__bar">
          <p
            id="results-count"
            class="results__count"
            role="status"
            data-count-one={t("teams.count.one")}
            data-count-other={t("teams.count.other")}
          >
            {tr.plural("teams.count", items.length)}
          </p>
            <MapSwitch lang={lang} />
          </div>
          <div class="results__searchrow"><SearchBox lang={lang} kind="teams" /></div>
          <MapView lang={lang} mode="all" kind="teams" />
          <div
            id="results-none"
            class="results__none"
            hidden
            data-match={t("teams.none_match")}
            data-hint={t("flexible.none_match_hint")}
            data-search-none={t("search.none")}
            data-search-hint={t("search.none_hint")}
          >
            <p data-none-main>{t("teams.none_match")}</p>
            <p class="muted" data-none-hint>{t("flexible.none_match_hint")}</p>
          </div>
          <ul id="listing-list" class="stack listing-list">
            {dated.map((e) => (
              <li
                data-id={e.id}
                data-search={cardSearchText(tr, e, settings)}
                data-section={e.section ?? ""}
                data-cause={e.cause ?? ""}
                data-join={e.join_method}
                data-over-at={e.overAt}
                {...mapAttrs(tr, e, settings, { href: paths.listing(lang, e.id), time: whenText(tr, e), when: whenText(tr, e) })}
              >
                <ListingCard
                  id={e.id}
                  href={paths.listing(lang, e.id)}
                  shareLabel={t("listing.share")}
                  shareUrl={paths.listing(lang, e.id)}
                  title={shownListing(e, lang).title.text}
                  titleLang={shownListing(e, lang).title.lang}
                  orgLang={e.listing_language}
                  translatedLabel={shownListing(e, lang).translated ? t("listing.translated_automatically") : undefined}
                  org={e.org_name}
                  hostedBy={t("listing.hosted_by")}
                  when={whenText(tr, e)}
                  datetime={e.start}
                  place={placeText(tr, e, settings)}
                  placeSpoken={placeSpoken(tr, e, settings)}
                  teamLabel={t("teams.tag")}
                  facts={teamFacts(e)}
                  cause={e.cause}
                  joinMethod={e.join_method}
                  joinLabel={joinLabel(tr, e)}
                  headingLevel={2}
                />
                <MapCardLines lang={lang} item={e} />
              </li>
            ))}
            {arranged.map((o) => (
              <li
                data-id={o.id}
                data-search={cardSearchText(tr, o, settings)}
                data-section={o.section ?? ""}
                data-cause={o.cause ?? ""}
                data-join={o.join_method}
                {...mapAttrs(tr, o, settings, { href: o.signup_url })}
              >
                <ListingCard
                  id={o.id}
                  href={o.signup_url}
                  shareLabel={t("listing.share")}
                  shareUrl={o.signup_url}
                  external
                  describedBy="external-note"
                  title={shownListing(o, lang).title.text}
                  titleLang={shownListing(o, lang).title.lang}
                  orgLang={o.listing_language}
                  translatedLabel={shownListing(o, lang).translated ? t("listing.translated_automatically") : undefined}
                  org={o.org_name}
                  hostedBy={t("listing.hosted_by")}
                  place={placeText(tr, o, settings)}
                  placeSpoken={placeSpoken(tr, o, settings)}
                  teamLabel={t("teams.tag")}
                  flexibleLabel={t("flexible.tag")}
                  facts={teamFacts(o)}
                  cause={o.cause}
                  joinMethod={o.join_method}
                  joinLabel={t(`filters.join.${o.join_method}`)}
                  headingLevel={2}
                />
                <OriginalText lang={lang} item={o} />
                <CardLogLink lang={lang} item={o} id={o.id} title={shownListing(o, lang).title.text} titleLang={shownListing(o, lang).title.lang} />
                <MapCardLines lang={lang} item={o} />
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p id="teams-none">{t("teams.none")}</p>
      )
    }
  </div>
  <SharePanel lang={lang} />
</Base>

{
  any && (
    <script>
      import "../../../scripts/flexible-filters.ts";
      import "../../../scripts/share-panel.ts";
    </script>
  )
}

<style>
  .tap-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .teams__back {
    margin: 0;
  }
</style>
