---
/**
 * Contact (owner, 2026-11-12 and 2026-11-13; PROJECT.md 5; decision 0046).
 * The contact form right under the heading (owner, 2026-11-13: no reasons
 * list, no subheading), one "Prefer email?" line, and the
 * Instagram account from src/data/links.json with the photo rules. Linked
 * from the footer; the About and Progress pages keep their direct email links.
 *
 * The form (decision 0046) is plain HTML that posts to the private contact
 * Worker (contact_form.action in links.json); it works without our own
 * script. The Worker sends people back to /<lang>/contact/thanks/ or to this
 * page with ?error=<code>; scripts/contact-form.ts shows that error's message
 * at the top. Cloudflare Turnstile (the spam check) is the site's only script
 * from another site, and it loads on this page only, only when a real site key
 * is set. While links.json holds the placeholder, no form and no outside
 * script: one "Email us:" line with the address takes the form's place.
 */
import Base from "../../../layouts/Base.astro";
import { languagePaths, paths, siteData, translator } from "../../../lib/site.ts";
import { siteLinks } from "../../../lib/links.ts";
import { templateParts } from "../../../lib/map.ts";

export const getStaticPaths = languagePaths;

const { lang } = Astro.params as { lang: string };
const { i18n, settings } = siteData();
const tr = translator(lang);
const t = tr.t;
const alternates = Object.fromEntries(i18n.languages.map((code) => [code, paths.contact(code)]));
const email = settings.site.contact_email;
const instagram = siteLinks().instagram;
const form = siteLinks().contactForm;
// The Worker's menu values and their words (support/contact-worker README, private).
const kinds = [
  ["listing-fix", "listing_fix"],
  ["add-org", "add_org"],
  ["press", "press"],
  ["other", "other"],
  ["build-city", "build_city"], // last (owner, 2026-11-13)
] as const;
// The Worker's error codes and their messages; {email} is the contact address.
const errorCodes = ["kind", "name", "email", "message", "turnstile", "too-large", "bad-request", "config", "send", "method"];
const errorData = Object.fromEntries(errorCodes.map((code) => [`data-error-${code}`, t(`contact.error.${code.replace("-", "_")}`, { email })]));
const [preferBefore, preferAfter] = t("contact.form.prefer_email").split("{email}");
const [emailBefore, emailAfter] = t("contact.email_us").split("{email}");
const tag = instagram ? templateParts(t("contact.instagram"), { handle: { text: instagram.handle, lang: "en" } }) : [];
---

<Base lang={lang} title={t("contact.title")} alternates={alternates} path={paths.contact(lang)}>
  {/* Cloudflare Turnstile, the form's spam check: this page only, only with a real site key (decision 0046). */}
  {form && <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <div class="page contact">
    <p class="contact__back"><a class="tap-link" href={paths.home(lang)}>{t("listing.back")}</a></p>
    <h1>{t("contact.title")}</h1>

    {/* An error sent back by the Worker (?error=<code>), shown and focused by scripts/contact-form.ts. */}
    {form && <div id="contact-error" class="contact__error" role="alert" tabindex="-1" hidden {...errorData}></div>}

    {/* No form (placeholder key): the one way to reach us is the address. */}
    {
      !form && (
        <p class="contact__email-us" data-contact-email>
          {emailBefore}<a class="contact__email" href={`mailto:${email}`}>{email}</a>{emailAfter ?? ""}
        </p>
      )
    }

    {
      form && (
        <div class="contact__form-wrap" data-contact-form>
          <form class="contact-form" method="post" action={form.action} enctype="application/x-www-form-urlencoded">
            <input type="hidden" name="lang" value={lang} />
            <div class="field">
              <label for="contact-kind">{t("contact.form.kind")}</label>
              <select id="contact-kind" name="kind" required>
                {kinds.map(([value, key]) => <option value={value}>{t(`contact.form.kinds.${key}`)}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="contact-name">{t("contact.form.name")} <span class="muted">{t("contact.form.optional")}</span></label>
              <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" />
            </div>
            <div class="field">
              <label for="contact-email">{t("contact.form.email")} <span class="muted">{t("contact.form.required")}</span></label>
              <input id="contact-email" name="email" type="email" maxlength="254" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="contact-message">{t("contact.form.message")} <span class="muted">{t("contact.form.required")}</span></label>
              <textarea id="contact-message" name="message" rows="6" maxlength="4000" required></textarea>
            </div>
            {/* The honeypot: hidden from people and from screen readers; bots fill it in. */}
            <div class="contact__hp" aria-hidden="true">
              <label for="contact-website">{t("contact.form.honeypot")}</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="cf-turnstile" data-sitekey={form.siteKey} data-language={lang}></div>
            <p id="contact-kept" class="contact__kept" data-contact-kept>{t("contact.form.retention")}</p>
            <button type="submit" class="contact__send" aria-describedby="contact-kept">{t("contact.form.send")}</button>
          </form>
          <p class="contact__prefer">
            {preferBefore}<a class="contact__email" href={`mailto:${email}`}>{email}</a>{preferAfter ?? ""}
          </p>
        </div>
      )
    }

    {
      instagram && (
        <section aria-labelledby="contact-instagram" data-contact-instagram>
          <h2 id="contact-instagram">{t("contact.instagram_heading")}</h2>
          <p>
            {tag.map((part) =>
              part.lang ? (
                <a href={instagram.url} lang={part.lang} rel="noopener noreferrer">{part.text}</a>
              ) : (
                part.text
              ),
            )}
          </p>
          {/* The owner's photo tips (2026-11-13): a lead-in, then a numbered list. */}
          <p id="contact-tips" class="contact__tips-lead">{t("contact.tips.lead")}</p>
          <ol class="contact__tips" aria-labelledby="contact-tips" data-contact-tips>
            <li>{t("contact.tips.consent")}</li>
            <li>{t("contact.tips.children")}</li>
            <li data-contact-risk>{t("contact.tips.risk")}</li>
          </ol>
        </section>
      )
    }
  </div>
</Base>

{
  form && (
    <script>
      import "../../../scripts/contact-form.ts";
    </script>
  )
}

<style>
  .tap-link,
  .contact__email {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }
  .contact__back {
    margin: 0;
  }
  /* The form: one column, 48 px controls, works at 360 px. */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block: var(--space-3);
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    min-height: var(--tap);
    font: inherit;
  }
  .contact-form textarea {
    min-height: 9rem;
  }
  .contact__send {
    align-self: flex-start;
    min-height: var(--tap);
    padding: 0 var(--space-5);
    border: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font: inherit;
    font-weight: var(--weight-strong);
    cursor: pointer;
  }
  .contact__send:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--color-focus-inner);
  }
  /* Off screen and out of the Tab order: people never see or reach the honeypot. */
  .contact__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact__error {
    margin-block: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-notice-border);
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-notice-bg);
    color: var(--color-ink);
    font-weight: var(--weight-strong);
  }
  .contact__error[hidden] {
    display: none;
  }
  .contact__error:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .contact__tips-lead {
    margin-bottom: var(--space-2);
  }
  .contact__tips {
    margin: 0 0 var(--space-4);
    padding-inline-start: 1.5em;
  }
  .contact__tips li + li {
    margin-top: var(--space-2);
  }
  .contact__email-us,
  .contact__form-wrap {
    margin: 0 0 var(--space-5);
  }
  .contact a[lang] {
    display: inline-block;
    min-height: 2.75rem;
    padding-block: 0.625rem;
    line-height: 1.5;
  }
</style>
