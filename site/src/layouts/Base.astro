---
/**
 * The frame of every page (PROJECT.md 2, 5; decision 0009).
 * Language, title, the test-build line and noindex, skip link, header,
 * rewards line, main content and footer. Styles come from pv-design
 * (src/styles/, src/components/ui/).
 */
import "../styles/global.css";
import SvgSprite from "../components/ui/SvgSprite.astro";
import TestBanner from "../components/ui/TestBanner.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PreviewTags from "../components/PreviewTags.astro";
import { siteData, translator } from "../lib/site.ts";

interface Props {
  lang: string;
  /** The page's own title. The site name is used when left out. */
  title?: string;
  /** Language of the title text, when it is the organization's own wording. */
  titleLang?: string;
  /** This page's address in every language, for the language switch. */
  alternates: Record<string, string>;
  /** This page's path, for the link-preview address (decision 0014). */
  path: string;
  /**
   * Leave out every script that uses browser storage: tidying saved hearts
   * and remembering the language choice. The Medicaid calculator (decision
   * 0022) runs no storage code at all.
   */
  noStorage?: boolean;
  /** The page has a map: its credits go in the footer (decision 0035; owner, 2026-11-10). */
  mapCredits?: boolean;
}

const { lang, title, alternates, path, noStorage = false, mapCredits = false } = Astro.props;
const { testBuild, siteUrl, settings, listings } = siteData();
// Every listing in this build and when it is over, so the browser can clear
// saved shifts that have ended (owner, Q32). Ids are letters, digits, - and _.
const live = JSON.stringify(listings.map((e) => [e.id, e.overAt]));
const tr = translator(lang);
const siteName = tr.setting(settings.site.name);
const pageTitle = title ?? siteName;
const absolute = (path: string) => (siteUrl ? siteUrl + path : path);
---

<!doctype html>
<html lang={tr.lang} dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* "light dark": we have our own dark colours, so browsers such as Chrome on Android
        do not darken the page themselves. The page is light unless the person turns on
        Dark mode (owner, 2026-11-10). */}
    <meta name="color-scheme" content="light dark" />
    {
      // Before the first paint: the person's own Dark mode choice, kept only in this
      // browser (localStorage). No cookie, nothing in the address, nothing sent.
      // Pages that use no storage (the Medicaid calculator) stay light.
      !noStorage && (
        <script is:inline>
          try {
            if (localStorage.getItem("cvh.theme") === "dark") document.documentElement.dataset.theme = "dark";
          } catch (e) {}
        </script>
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={tr.t("site.description")} />
    {testBuild && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <PreviewTags lang={lang} path={path} />
    {
      Object.entries(alternates).map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={absolute(href)} />
      ))
    }
    <slot name="head" />
  </head>
  <body>
    <SvgSprite />
    {testBuild && <TestBanner text={tr.t("site.test_version")} note={tr.t("site.footer_sources")} />}
    <a class="skip-link" href="#main">{tr.t("site.skip_to_content")}</a>
    <SiteHeader lang={lang} alternates={alternates} noStorage={noStorage} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} path={path} testBuild={testBuild} noStorage={noStorage} mapCredits={mapCredits} />
    {!noStorage && <script type="application/json" id="live-listings" set:html={live} />}
    {
      !noStorage && (
        <script>
          import { pruneSavedNow } from "../scripts/device.ts";
          pruneSavedNow();
        </script>
      )
    }
  </body>
</html>
