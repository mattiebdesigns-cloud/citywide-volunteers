---
/**
 * Header (docs/briefs/phase1-home-page.md): site name from the settings,
 * the About link and the language switch. The Filters button sits beside
 * each page's heading (components/ResultsHeading.astro). (The "rewards are coming" line was removed at the owner's request,
 * 2026-11-08.)
 * The site name is shown as the logo (owner's pick A4, 2026-11-10; docs/design.md
 * "Header logo"). The drawing (components/ui/logo.svg) is put
 * straight into the page, so it costs no extra download (the Medicaid page
 * allows no images). It is hidden from screen readers; the link's name is the
 * site name from the settings, in visually hidden text.
 */
import LanguageSwitch from "./LanguageSwitch.astro";
import logo from "./ui/logo.svg?raw";
import { paths, siteData, translator } from "../lib/site.ts";

interface Props {
  lang: string;
  alternates: Record<string, string>;
  /** Passed to the language switch: remember nothing in browser storage. */
  noStorage?: boolean;
  /** This page's path, so the link to it is marked aria-current="page". */
  path?: string;
}

const { lang, alternates, noStorage = false, path } = Astro.props;
const current = (href: string) => (href === path ? "page" : undefined);
const tr = translator(lang);
const siteName = tr.setting(siteData().settings.site.name);
const pages = [
  { href: paths.about(lang), label: tr.t("about_page.nav") },
  { href: paths.medicaid(lang), label: tr.t("medicaid.title") },
];
// The drawing without its notes, so they are not sent with every page.
const logoSvg = logo.replace(/<!--[\s\S]*?-->\s*/g, "");
---

<header class="site-header">
  <div class="page site-header__inner">
    <p class="site-header__name">
      <a href={paths.home(lang)} aria-current={current(paths.home(lang))}>
        <span class="site-header__logo" set:html={logoSvg} />
        <span class="sr-only">{siteName}</span>
      </a>
    </p>
    <div class="site-header__side">
      <LanguageSwitch lang={lang} alternates={alternates} noStorage={noStorage} />
      {/* About and the calculator, top right (owner, 2026-11-10; Flexible and Teams links sit under the home page's Filters button). */}
      <nav class="site-header__pages" aria-label={tr.t("site.pages_nav")}>
        <ul>
          {pages.map((p) => (
            <li><a href={p.href} aria-current={current(p.href)}>{p.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  {tr.isBeta && <p class="page site-header__beta muted">{tr.t("language.beta_note")}</p>}
</header>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-2);
  }
  .site-header__name {
    margin: 0;
    font-weight: var(--weight-heavy);
  }
  /* 48 px tap target for the site name link. */
  .site-header__name a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  /* Logo: 56 px tall on phones (150 px wide, fits the 360 px header), 64 px from
     480 px wide. Sized in rem so it grows with the reader's text size. */
  .site-header__logo :global(svg) {
    display: block;
    height: 3.5rem;
    width: auto;
    aspect-ratio: 1440 / 540;
  }
  @media (min-width: 30rem) {
    .site-header__logo :global(svg) {
      height: 4rem;
    }
  }
  /* Right side: the language switch, then the page list under it, right-aligned. */
  .site-header__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 0;
    margin-inline-start: auto;
  }
  .site-header__pages ul {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: end;
  }
  /* A tight list: each link a 48 px tall target (accessibility gate), wrapping if a name is long. */
  .site-header__pages a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-2);
    overflow-wrap: anywhere;
  }
  /* The link to the page you are on, shown the way the language switch shows it. */
  .site-header__pages a[aria-current="page"] {
    font-weight: var(--weight-strong);
    text-decoration-thickness: 0.2em;
  }
  .site-header__beta {
    margin: 0 auto var(--space-2);
  }
</style>
