---
/**
 * The "List | Map" switch (decision 0035), on the same line as the count, on
 * the right (owner, 2026-11-10). It opens and closes the map section that
 * components/MapView.astro puts under the search box; scripts/map-view.ts
 * runs it. Hidden until that script runs, as the map needs JavaScript.
 * Reading order: count, then this switch, then the search box.
 */
import { translator } from "../lib/site.ts";

interface Props {
  lang: string;
}

const t = translator(Astro.props.lang).t;
---

<div class="map-switch" role="group" aria-label={t("map.view_label")} data-map-switch hidden>
  <button type="button" class="map-switch__button" aria-pressed="true" data-map-view="list">{t("map.view_list")}</button>
  <button type="button" class="map-switch__button" aria-pressed="false" data-map-view="map" aria-controls="map-section">{t("map.view_map")}</button>
</div>

<style>
  .map-switch {
    display: inline-flex;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-sm, 0.5rem);
    overflow: hidden;
    flex: none;
  }
  .map-switch[hidden] {
    display: none;
  }
  .map-switch__button {
    min-height: var(--tap);
    padding: 0 0.75rem;
    border: 0;
    background: var(--color-surface);
    color: var(--color-primary);
    font: inherit;
    font-weight: var(--weight-strong, 600);
    cursor: pointer;
  }
  /* The chosen view: filled, and aria-pressed tells screen readers. */
  .map-switch__button[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .map-switch__button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -5px;
    box-shadow: inset 0 0 0 2px var(--color-focus-inner);
  }
</style>
