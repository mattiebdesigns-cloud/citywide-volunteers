---
/**
 * Footer: where listings come from (PROJECT.md 2). The page links moved to
 * the header (owner, 2026-11-10). In a test build the sentence is in the
 * banner at the top instead, and the layout leaves the footer out.
 */
import { translator } from "../lib/site.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const tr = translator(lang);
---

<footer class="site-footer">
  <div class="page">
    <p class="muted">{tr.t("site.footer_sources")}</p>
  </div>
</footer>
