---
/** Footer: where listings come from (PROJECT.md 2). */
import { paths, translator } from "../lib/site.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const tr = translator(lang);
---

<footer class="site-footer">
  <div class="page">
    <p class="muted">{tr.t("site.footer_sources")}</p>
    <p><a class="site-footer__link" href={paths.medicaid(lang)}>{tr.t("medicaid.home_link")}</a></p>
  </div>
</footer>

<style>
  /* 48 px tap target. */
  .site-footer__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
</style>
