{
  "name": "citywide-volunteers-site",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Phase 1 calendar website for Citywide Volunteers (static, Astro).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:test": "PV_TEST_BUILD=1 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:licences": "node scripts/check-licences.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "astro": "7.4.0",
    "lightningcss": "file:vendor/no-lightningcss",
    "maplibre-gl": "6.17.0",
    "pmtiles": "4.5.0",
    "sharp": "file:vendor/no-sharp",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "lightningcss": "$lightningcss"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2"
  }
}
